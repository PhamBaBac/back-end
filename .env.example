# =============================================================================
# OmniAI Seller Hub - Backend Environment Configuration
# =============================================================================

# Server Environment
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# PostgreSQL Database (with pgvector extension)
DB_USER=omni_admin
DB_PASSWORD=omni_secret_pass
DB_NAME=omniai_seller_hub
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=postgresql://omni_admin:omni_secret_pass@localhost:5432/omniai_seller_hub?schema=public

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=omni_redis_secret

# Security & Cryptography
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_security
JWT_EXPIRES_IN=7d
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef # 64 hex characters (32 bytes AES-256)

# AI & LLM Providers
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# E-Commerce Multi-Channel Open APIs
# TikTok Shop
TIKTOK_APP_KEY=your_tiktok_app_key
TIKTOK_APP_SECRET=your_tiktok_app_secret

# Shopee Open Platform
SHOPEE_PARTNER_ID=your_shopee_partner_id
SHOPEE_PARTNER_KEY=your_shopee_partner_key

# Lazada Open Platform
LAZADA_APP_KEY=your_lazada_app_key
LAZADA_APP_SECRET=your_lazada_app_secret
