// =============================================================================
// Prisma Schema for OmniAI Seller Hub
// PostgreSQL with pgvector extension enabled
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  OWNER
  ADMIN
  STAFF
}

enum Platform {
  TIKTOK
  SHOPEE
  LAZADA
}

enum SubscriptionPlan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum SenderType {
  CUSTOMER
  AI
  AGENT
}

// -----------------------------------------------------------------------------
// 1. Tenant / Shop Management (Multi-Tenancy Anchor)
// -----------------------------------------------------------------------------
model Shop {
  id               String           @id @default(uuid()) @db.Uuid
  name             String
  code             String           @unique
  plan             SubscriptionPlan @default(FREE)
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  users            User[]
  integrations     ShopIntegration[]
  products         Product[]
  productEmbeddings ProductEmbedding[]
  orders           Order[]
  conversations    Conversation[]

  @@map("shops")
}

// -----------------------------------------------------------------------------
// 2. User & Authentication
// -----------------------------------------------------------------------------
model User {
  id           String    @id @default(uuid()) @db.Uuid
  shopId       String    @db.Uuid @map("shop_id")
  email        String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  role         Role      @default(STAFF)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  shop         Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@map("users")
}

// -----------------------------------------------------------------------------
// 3. E-commerce Multi-Channel Integrations & Encrypted Tokens
// -----------------------------------------------------------------------------
model ShopIntegration {
  id                    String    @id @default(uuid()) @db.Uuid
  shopId                String    @db.Uuid @map("shop_id")
  platform              Platform
  platformShopId        String    @map("platform_shop_id")
  accessTokenEncrypted  String    @map("access_token_encrypted")  // AES-256-GCM
  refreshTokenEncrypted String    @map("refresh_token_encrypted") // AES-256-GCM
  tokenExpiresAt        DateTime  @map("token_expires_at")
  isActive              Boolean   @default(true) @map("is_active")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  shop                  Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, platform, platformShopId])
  @@index([shopId, platform])
  @@map("shop_integrations")
}

// -----------------------------------------------------------------------------
// 4. Products & Catalog Synchronization
// -----------------------------------------------------------------------------
model Product {
  id            String             @id @default(uuid()) @db.Uuid
  shopId        String             @db.Uuid @map("shop_id")
  platform      Platform
  externalId    String             @map("external_id")
  title         String
  sku           String
  price         Decimal            @db.Decimal(12, 2)
  stockQuantity Int                @default(0) @map("stock_quantity")
  category      String?
  description   String?
  material      String?
  sizeChart     String?            @map("size_chart")
  isActive      Boolean            @default(true) @map("is_active")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  shop          Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  variants      ProductVariant[]
  embeddings    ProductEmbedding[]

  @@unique([shopId, platform, externalId])
  @@index([shopId, sku])
  @@index([shopId, isActive])
  @@map("products")
}

model ProductVariant {
  id            String    @id @default(uuid()) @db.Uuid
  productId     String    @db.Uuid @map("product_id")
  sku           String
  name          String
  price         Decimal   @db.Decimal(12, 2)
  stockQuantity Int       @default(0) @map("stock_quantity")
  color         String?
  size          String?

  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_variants")
}

// -----------------------------------------------------------------------------
// 5. pgvector Semantic Search Embeddings (OpenAI 1536 dims)
// -----------------------------------------------------------------------------
model ProductEmbedding {
  id          String                 @id @default(uuid()) @db.Uuid
  shopId      String                 @db.Uuid @map("shop_id")
  productId   String                 @db.Uuid @map("product_id")
  content     String
  embedding   Unsupported("vector(1536)")
  metadata    Json
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  shop        Shop                   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product     Product                @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([productId])
  @@map("product_embeddings")
}

// -----------------------------------------------------------------------------
// 6. Orders & Financial Metrics
// -----------------------------------------------------------------------------
model Order {
  id              String       @id @default(uuid()) @db.Uuid
  shopId          String       @db.Uuid @map("shop_id")
  platform        Platform
  externalOrderId String       @map("external_order_id")
  customerId      String?      @map("customer_id")
  customerName    String?      @map("customer_name")
  totalAmount     Decimal      @db.Decimal(12, 2) @map("total_amount")
  costAmount      Decimal      @default(0) @db.Decimal(12, 2) @map("cost_amount")
  platformFee     Decimal      @default(0) @db.Decimal(12, 2) @map("platform_fee")
  status          OrderStatus  @default(PENDING)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  shop            Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, platform, externalOrderId])
  @@index([shopId, createdAt])
  @@index([shopId, status])
  @@map("orders")
}

// -----------------------------------------------------------------------------
// 7. Omnichannel Customer Conversations & Chat
// -----------------------------------------------------------------------------
model Conversation {
  id             String        @id @default(uuid()) @db.Uuid
  shopId         String        @db.Uuid @map("shop_id")
  platform       Platform
  externalChatId String        @map("external_chat_id")
  customerId     String        @map("customer_id")
  customerName   String?       @map("customer_name")
  isAiHandled    Boolean       @default(true) @map("is_ai_handled")
  lastMessageAt  DateTime      @default(now()) @map("last_message_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  shop           Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  messages       ChatMessage[]

  @@unique([shopId, platform, externalChatId])
  @@index([shopId, lastMessageAt])
  @@map("conversations")
}

model ChatMessage {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid @map("conversation_id")
  shopId         String       @db.Uuid @map("shop_id")
  senderType     SenderType   @map("sender_type")
  content        String
  rawPayload     Json?        @map("raw_payload")
  sentAt         DateTime     @default(now()) @map("sent_at")

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, sentAt])
  @@index([shopId])
  @@map("chat_messages")
}
